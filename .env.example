# Database configuration (PostgreSQL for Docker/Production, SQLite for Zero-Setup Local Dev)
DATABASE_URL=sqlite:///./campusflow.db
# DATABASE_URL=postgresql://campusflow:campusflow_password@localhost:5432/campusflow_db

# Security
JWT_SECRET=super-secret-campusflow-agentic-jwt-key-2026

# AI LLM Provider Configuration
# Options: "mock" (100% autonomous local execution) or "openai"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# CORS Configuration (comma-separated or wildcard)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
